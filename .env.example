APP_NAME="SLC University Clinic System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL (XAMPP: user root, blank password). Create the database first, see README.md.
# Laravel reads DB_USERNAME (the Node version called it DB_USER).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clinic_laravel
DB_USERNAME=root
DB_PASSWORD=

# Login sessions last 8 hours (480 minutes), stored in files.
SESSION_DRIVER=file
SESSION_LIFETIME=480
# Set to true when the site is served over HTTPS (also turns on the HSTS header).
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12

# Shown on the printable prescription slip.
UNIVERSITY_NAME="University of La Salette, Inc."
CLINIC_NAME="Health Services Department"
CLINIC_ADDRESS="Castroverde St., Dubinan West, Santiago City, Isabela 3311"
CLINIC_CONTACT=
# Optional: only accept logins and changes from this exact origin (e.g. https://clinic.example.edu).
CLINIC_ORIGIN=
